# AutoFlow AI — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# Secrets are resolved only at the provider/connector boundary and must never
# reach the desktop renderer, model prompts, or logs.

# ---- Application ----
APP_ENV=development
LOG_LEVEL=INFO

# ---- Datastores ----
DATABASE_URL=postgresql://autoflow:autoflow@localhost:5432/autoflow
REDIS_URL=redis://localhost:6379/0
CHROMA_URL=
CHROMA_PATH=./.chroma

# ---- Primary model (planner/executor) ----
# The gateway speaks the OpenAI-compatible Chat Completions API, so any of the
# following work by setting PROVIDER=openai_compatible and the right BASE_URL:
#
#   NVIDIA NIM:   BASE_URL=https://integrate.api.nvidia.com/v1
#                 ID=meta/llama-3.2-11b-vision-instruct   (list: GET /v1/models)
#   OpenAI:       BASE_URL=https://api.openai.com/v1
#                 ID=gpt-4o-mini
#   Groq:         BASE_URL=https://api.groq.com/openai/v1
#                 ID=llama-3.3-70b-versatile
#   OpenRouter:   BASE_URL=https://openrouter.ai/api/v1
#                 ID=meta-llama/llama-3.1-8b-instruct
#   vLLM (local): BASE_URL=http://localhost:8000/v1
#   Ollama:       BASE_URL=http://localhost:11434/v1
#
PRIMARY_MODEL_PROVIDER=openai_compatible
PRIMARY_MODEL_ID=meta/llama-3.2-11b-vision-instruct
PRIMARY_MODEL_API_KEY=
PRIMARY_MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
PRIMARY_MODEL_CONTEXT=128000

# ---- Secondary / fallback model (optional) ----
# Set *_MODEL_STREAMING=true for providers that only return content via SSE
# streaming (e.g. ModelScope reasoning models like Qwen/Qwen3-8B).
#   ModelScope: BASE_URL=https://api-inference.modelscope.ai/v1
#               ID=Qwen/Qwen3-8B  STREAMING=true
SECONDARY_MODEL_PROVIDER=
SECONDARY_MODEL_ID=
SECONDARY_MODEL_API_KEY=
SECONDARY_MODEL_BASE_URL=
SECONDARY_MODEL_CONTEXT=128000
SECONDARY_MODEL_STREAMING=false

# ---- Vision model ----
VISION_MODEL_PROVIDER=
VISION_MODEL_ID=
VISION_MODEL_API_KEY=

# ---- RAG (knowledge / semantic retrieval) ----
RAG_ENABLED=true
RAG_TOP_K=8
RAG_MAX_TOP_K=20
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MIN_SCORE=0.0
RAG_RERANK_ENABLED=false
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=autoflow_knowledge
MAX_DOCUMENT_SIZE_MB=25
MAX_CHUNKS_PER_DOCUMENT=5000

# ---- Memory (session / workflow / graph) ----
MEMORY_ENABLED=true
WORKFLOW_MEMORY_ENABLED=true
WORKFLOW_MEMORY_COLLECTION=autoflow_workflows
MEMORY_DB_PATH=./data/memory.sqlite
WORKFLOW_RETRIEVAL_TOP_K=5
WORKFLOW_MEMORY_MIN_SCORE=0.0
WORKFLOW_AUTO_PROMOTION=false
WORKFLOW_MAX_VERSIONS=50
MEMORY_FAILURE_DECAY=true
MEMORY_RECENCY_WEIGHT=0.15
MEMORY_SUCCESS_WEIGHT=0.35
MEMORY_COMPATIBILITY_WEIGHT=0.30
MEMORY_SEMANTIC_WEIGHT=0.20

# ---- Embeddings ----
# EMBEDDING_PROVIDER: "local" (deterministic hashing, offline, non-semantic
# baseline) or "openai_compatible" (real semantic embeddings via an
# OpenAI-compatible /embeddings endpoint: NVIDIA NIM, ModelScope, OpenAI, etc.)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384

# ---- Model call policy ----
MODEL_TIMEOUT=60
MODEL_MAX_RETRIES=2

# ---- Execution budgets (bounded autonomy) ----
MAX_TOOL_CALLS=50
MAX_REPLANS=3
MAX_RECOVERY_ATTEMPTS=5

# ---- Execution surfaces (disabled by default) ----
BROWSER_EXECUTION_ENABLED=false
DESKTOP_EXECUTION_ENABLED=false

# ---- Communication connector ----
EMAIL_PROVIDER=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=

# ---- Local deployment / server (added in the integration pass) ----
# Local orchestration API + frontend (autoflow serve).
AUTOFLOW_HOST=127.0.0.1
AUTOFLOW_PORT=8770
# Model cache root for downloadable local models (never inside the repo).
AUTOFLOW_MODEL_HOME=
# Opt-in gates for real (non-simulated) capabilities. Leave empty/0 for safe defaults.
AUTOFLOW_ALLOW_WEB=0
AUTOFLOW_REAL_WORD=0
AUTOFLOW_REAL_GMAIL=0
AUTOFLOW_REAL_VISION=0
AUTOFLOW_LIVE_NVIDIA=0
# Mission checkpoint store (defaults to ./.autoflow/missions when unset).
AUTOFLOW_MISSION_DIR=

# ---- On-device tool-calling agent (Cactus Needle 2) ----
# Optional. Install with:  uv pip install cactus-needle
# The fine-tuned weights (my_agent.cact, ~14MB) ship inside the package, so no
# download is needed. Override the weights path or output dir if you want:
AUTOFLOW_NEEDLE_WEIGHTS=
AUTOFLOW_NEEDLE_OUTPUT=
# Enable the live on-device model test:  AUTOFLOW_NEEDLE_LIVE=1
AUTOFLOW_NEEDLE_LIVE=0

# ============================================================================
# Control Plane (backend/) + AI/ML integration + Desktop connected mode
# ----------------------------------------------------------------------------
# These wire the three systems together for the integration pass:
#   Electron desktop  ->  Control Plane (backend, :8000)  ->  AI/ML runtime (:8770)
# The Control Plane defaults to MOCK mode so it boots with no infra. Flip to
# integration mode to route planning/execution/verification/approval through the
# real out-of-process AI/ML mission server.
# ============================================================================

# ---- Control Plane runtime mode ----
# INTELLIGENCE_MODE: "mock" (default, deterministic, no AI/ML server) or
# "integration" (use the real AI/ML runtime over HTTP). NOTE: the backend reads
# these names verbatim (pydantic-settings, case-insensitive, no prefix).
INTELLIGENCE_MODE=mock
# The AI/ML mission server base URL (the ai-ml server from `run_server`).
AI_ML_URL=http://127.0.0.1:8770
# Enable/disable the AI/ML seam entirely (mock is used when disabled).
AI_ML_ENABLED=true
# Per-mission wait budget (seconds) for the AI/ML runtime.
AI_ML_TIMEOUT_SECONDS=120
# When true, the AI/ML runtime plans/executes with real LLMs (uses the model
# keys above). When false it runs the deterministic society orchestration.
AI_ML_USE_MODEL=false

# ---- Control Plane server / datastore (backend/app/core/config.py) ----
# Empty DATABASE_URL/REDIS_URL fall back to a local SQLite file + in-process
# queue, so the backend runs with zero external infra.
# DATABASE_URL=postgresql+asyncpg://autoflow:autoflow@localhost:5432/autoflow
# REDIS_URL=redis://localhost:6379/0
API_HOST=127.0.0.1
API_PORT=8000

# ---- Desktop connected mode (desktop/.env) ----
# Leave NEXT_PUBLIC_API_URL empty to run the desktop on local mock data
# (default). Point it at the running Control Plane to render REAL data + live
# SSE without any code change:
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=
# Dev bearer token (the backend's mock auth accepts any non-empty token).
NEXT_PUBLIC_API_TOKEN=dev

# ============================================================================
# Real external side effects (Phase 10) — DEFAULT OFF
# ----------------------------------------------------------------------------
# These gate genuinely real side effects (e.g. sending real email). They are
# OFF by default so no external action can occur without explicit opt-in.
# Secrets go ONLY in the untracked .env, never here and never in code/logs.
# ============================================================================

# Master gate. false => no real side effect can occur (SIMULATION/INTEGRATION).
AUTOFLOW_ALLOW_REAL_SIDE_EFFECTS=false

# ---- Real email (SMTP). Requires AUTOFLOW_ALLOW_REAL_SIDE_EFFECTS=true too. ----
REAL_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated allowlist. Sends to any address not listed are refused.
EMAIL_RECIPIENT_ALLOWLIST=
# IMAP for independent post-send verification (confirm the message landed).
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# ---- Gemini (work-reassignment workflow) ----
# Google Generative Language API key + model. Used to pick the best colleague
# to cover an absent employee from an uploaded roster. Secret goes only in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
