AUTOFLOW_ENV=development

API_HOST=127.0.0.1
API_PORT=8000

# Durable state store.
# Dev default is a local SQLite file so the backend runs with zero infra.
# For production use PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+asyncpg://autoflow:autoflow@localhost:5432/autoflow
DATABASE_URL=sqlite+aiosqlite:///./autoflow.db

# Queue / transient coordination.
# Dev default is an in-process queue. For production use Redis, e.g.:
#   REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Runtime component modes. All mock now, real later — never change the API.
AUTH_MODE=mock
ORCHESTRATOR_MODE=mock
AGENT_RUNTIME_MODE=mock
TOOL_RUNTIME_MODE=mock
VERIFIER_MODE=mock
RECOVERY_MODE=mock
POLICY_MODE=mock

ARTIFACT_STORAGE_MODE=local
ARTIFACT_STORAGE_DIR=./artifacts

# Whether the API process should also run the execution worker inline.
# Convenient for demos; set to false and run the worker separately in prod.
RUN_INLINE_WORKER=true

# CORS origins allowed to call the API (Electron/Next dev).
CORS_ORIGINS=http://localhost:3000,app://.,http://127.0.0.1:3000

LOG_LEVEL=INFO
