{
  "name": "autoflow-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AutoFlow AI — desktop command center",
  "author": "AutoFlow AI",
  "main": "dist-electron/main.js",
  "scripts": {
    "next:dev": "cross-env NODE_ENV=development next dev -p 3000",
    "next:build": "cross-env NODE_ENV=production next build",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n NEXT,ELECTRON -c \"gray,white\" \"pnpm next:dev\" \"pnpm dev:electron\"",
    "dev:electron": "wait-on tcp:3000 && pnpm electron:build && pnpm electron:dev",
    "build": "pnpm next:build && pnpm electron:build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "package:win": "pnpm build && electron-builder --win",
    "package:portable": "pnpm build && electron-builder --win portable"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.3.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.5.6",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.2"
  }
}
