NEXT_PUBLIC_APP_NAME=AutoFlow AI
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_ENV=development

# Backend control plane.
# Leave empty to run the desktop on local mock data (default, zero backend).
# Set to the running control plane to use live data + SSE, e.g.:
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=
# Dev bearer token (backend mock auth accepts any non-empty token).
NEXT_PUBLIC_API_TOKEN=dev
